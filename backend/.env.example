PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
GEMINI_API_KEY="your_gemini_api_key_here"
JWT_SECRET="your_jwt_secret_here"

# Asal frontend yang boleh memanggil API (pisah koma). Wajib di produksi.
CORS_ORIGINS="http://localhost:5173"
# Password akun admin saat seed. Kosong = dibuat acak dan dicetak sekali di konsol.
SEED_ADMIN_PASSWORD=""
# Akun demo untuk juri (demo@siagakeluarga.id). Di produksi hanya dibuat bila SEED_DEMO=true.
SEED_DEMO="true"
SEED_DEMO_PASSWORD=""

# Peringatan ke grup keluarga lewat Telegram (opsional; kosong = fitur Telegram nonaktif)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Rahasia untuk penjadwal yang memanggil POST /api/cron/peringatan (Authorization: Bearer ...)
CRON_SECRET=""
# Alamat frontend, dipakai untuk tautan rencana di pesan Telegram
FRONTEND_URL=""
# Hanya pengembangan lokal: izinkan database tiruan di memori saat PostgreSQL tidak tersedia (nonaktif di produksi)
ALLOW_MOCK_DB=""
