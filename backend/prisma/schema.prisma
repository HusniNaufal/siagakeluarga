generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum AgeGroup {
  BALITA
  ANAK
  DEWASA
  LANSIA
}

enum HazardType {
  BANJIR
  GEMPA
  TSUNAMI
  LONGSOR
  CUACA_EKSTREM
}

enum HazardLevel {
  RENDAH
  SEDANG
  TINGGI
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  nama          String
  email         String      @unique
  password_hash String
  role          Role        @default(USER)
  households    Household[]

  @@map("users")
}

model Region {
  id              Int             @id @default(autoincrement())
  kode_wilayah    String          @unique
  kecamatan       String
  kab_kota        String
  households      Household[]
  hazard_zones    HazardZone[]
  assembly_points AssemblyPoint[]

  @@map("regions")
}

model Household {
  id          String          @id @default(uuid()) @db.Uuid
  user_id     String          @db.Uuid
  region_id   Int?
  lat         Decimal?        @db.Decimal(9, 6)
  lng         Decimal?        @db.Decimal(9, 6)
  share_token String?         @unique
  user        User            @relation(fields: [user_id], references: [id])
  region      Region?         @relation(fields: [region_id], references: [id])
  members     Member[]
  plans       EmergencyPlan[]
  kit_items   KitItem[]
  drills      Drill[]

  @@map("households")
}

model Member {
  id              String    @id @default(uuid()) @db.Uuid
  household_id    String    @db.Uuid
  panggilan       String
  kelompok_umur   AgeGroup
  kebutuhan_khusus String?
  household       Household @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@map("members")
}

model EmergencyPlan {
  id           String    @id @default(uuid()) @db.Uuid
  household_id String    @db.Uuid
  konten       Json
  model_ai     String
  created_at   DateTime  @default(now())
  household    Household @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@map("emergency_plans")
}

model KitItem {
  id           String    @id @default(uuid()) @db.Uuid
  household_id String    @db.Uuid
  nama_item    String
  status       Boolean   @default(false)
  kadaluarsa   DateTime? @db.Date
  household    Household @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@map("kit_items")
}

model Drill {
  id           String    @id @default(uuid()) @db.Uuid
  household_id String    @db.Uuid
  jadwal       DateTime
  skor         Int?
  household    Household @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@map("drills")
}

model HazardZone {
  id           Int         @id @default(autoincrement())
  region_id    Int
  jenis_bencana HazardType
  tingkat      HazardLevel
  sumber       String?
  region       Region      @relation(fields: [region_id], references: [id])

  @@map("hazard_zones")
}

model AssemblyPoint {
  id        Int     @id @default(autoincrement())
  region_id Int
  nama      String
  lat       Decimal @db.Decimal(9, 6)
  lng       Decimal @db.Decimal(9, 6)
  region    Region  @relation(fields: [region_id], references: [id])

  @@map("assembly_points")
}

model GuideChunk {
  id        Int                         @id @default(autoincrement())
  sumber    String
  isi       String
  embedding Unsupported("vector(768)")?

  @@map("guide_chunks")
}
